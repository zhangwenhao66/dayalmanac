---
/**
 * schema.org Event markup for the upcoming occurrences of an observance.
 *
 * Kept local to DayAlmanac rather than added to vendor/site-toolkit: six sites pin that
 * submodule at a commit each, so anything landing there needs its own release and a
 * regression pass on all of them. If a second site ever wants Event markup, that's the
 * moment to promote this upstream.
 *
 * Only occurrences from `today` onward are emitted. Past-dated Events are legitimate
 * markup but they describe something that has already happened, and Google's own
 * guidance is that event markup should represent events a user can still attend.
 *
 * `location` is a required field for Google's Event rich result (GSC flagged all
 * occurrences as invalid with "Missing field location" until this was added). These
 * observances have no physical venue, so `VirtualLocation` pointing at the guide's own
 * page is the truthful choice -- the "event" is the page itself, not a fabricated address.
 *
 * `eventAttendanceMode` must be `OnlineEventAttendanceMode` whenever `location` is a
 * `VirtualLocation` -- Google's Event rich result validator only accepts VirtualLocation
 * paired with this attendance mode; without it, GSC reports "Invalid object type for
 * field location" even though VirtualLocation is valid schema.org markup on its own.
 */
import { jsonLdStringify } from '../../vendor/site-toolkit/packages/schema/src/jsonLdStringify';
import type { Occurrence } from '../data/guides';

interface Props {
	name: string;
	description: string;
	url: string;
	occurrences: Occurrence[];
	/** ISO date used as "today"; defaults to build time. Injectable so tests can pin it. */
	today?: string;
}

const { name, description, url, occurrences, today } = Astro.props;

const cutoff = today ?? new Date().toISOString().slice(0, 10);
const upcoming = occurrences.filter((o) => o.date >= cutoff);

const data = upcoming.map((o) => ({
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: `${name} ${o.date.slice(0, 4)}`,
	description,
	startDate: o.date,
	endDate: o.date,
	url,
	eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
	location: {
		'@type': 'VirtualLocation',
		url,
	},
}));
---

{data.map((event) => <script type="application/ld+json" set:html={jsonLdStringify(event)} />)}
