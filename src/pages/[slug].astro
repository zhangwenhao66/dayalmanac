---
import Layout from '../layouts/Layout.astro';
import Article from '../../vendor/site-toolkit/packages/schema/src/Article.astro';
import BreadcrumbList from '../../vendor/site-toolkit/packages/schema/src/BreadcrumbList.astro';
import FAQPage from '../../vendor/site-toolkit/packages/schema/src/FAQPage.astro';
import { pickRelatedGuides } from '../../vendor/site-toolkit/packages/related-guides/src/index.ts';
import DateTable from '../components/DateTable.astro';
import ObservanceEvents from '../components/ObservanceEvents.astro';
import { guides, categorySlug, type Guide } from '../data/guides';
import { AUTHOR_NAME, SITE_ORIGIN } from '../consts';

export function getStaticPaths() {
	return guides.map((guide) => ({
		params: { slug: guide.slug },
		props: { guide },
	}));
}

interface Props {
	guide: Guide;
}

const { guide } = Astro.props;
// Rotating-window related-guides selection -- see vendor/site-toolkit/packages/related-guides
// for why this isn't a fixed .slice(0, 6) (that bug starved most of a category of any inbound link).
const related = pickRelatedGuides(guides, guide);

// Categories are open strings (the calendar keeps growing new families of pages), so
// the path is derived rather than looked up.
const catPath = `/topics/${categorySlug(guide.category)}/`;

const pageUrl = `${SITE_ORIGIN}/${guide.slug}/`;
const heroImage = `${SITE_ORIGIN}${guide.image ?? '/favicon.svg'}`;
const toISO = (d: string) => `${d}T00:00:00+00:00`;
const breadcrumbItems = [
	{ name: 'Home', item: `${SITE_ORIGIN}/` },
	{ name: guide.category, item: `${SITE_ORIGIN}${catPath}` },
	{ name: guide.title, item: pageUrl },
];

function md(text: string): string {
	return text
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		.replace(/\*(.*?)\*/g, '<em>$1</em>')
		.replace(/\[([^\]]+)\]\(((?:[^()]|\([^()]*\))*)\)/g, '<a href="$2">$1</a>');
}
---

<Layout title={guide.title} description={guide.description} ogImage={guide.image ?? '/favicon.svg'} ogType="article">
	{guide.faq && guide.faq.length > 0 && <FAQPage items={guide.faq} slot="head" />}
	<Article
		slot="head"
		headline={guide.title}
		description={guide.description}
		datePublished={toISO(guide.published ?? guide.updated)}
		dateModified={toISO(guide.updated)}
		authorName={AUTHOR_NAME}
		authorUrl={`${SITE_ORIGIN}/about/`}
		image={heroImage}
		url={pageUrl}
	/>
	<BreadcrumbList slot="head" items={breadcrumbItems} />
	{guide.dateRule && (
		<ObservanceEvents
			slot="head"
			name={guide.title}
			description={guide.description}
			url={pageUrl}
			occurrences={guide.dateRule.occurrences}
		/>
	)}

	<div class="mx-auto max-w-[880px]">
		<nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[var(--ink)]/40">
			<a href="/" class="no-underline hover:text-[var(--ink)] hover:underline">Home</a>
			<span>/</span>
			<a href={catPath} class="no-underline hover:text-[var(--ink)] hover:underline">{guide.category}</a>
		</nav>

		<header class="mx-auto max-w-[720px]">
			<p class="rubric m-0">{guide.category}</p>
			<h1 class="font-display mt-3 text-[2.1rem] leading-[1.12] font-semibold text-[var(--ink)] md:text-[2.6rem]">
				{guide.title}
			</h1>
			<p class="mt-4 text-[1.05rem] leading-relaxed text-[var(--ink)]/65">{guide.description}</p>
			<p class="mt-3 text-xs text-[var(--ink)]/40">Last updated {guide.updated}</p>
		</header>

		<div class="mx-auto mt-9 max-w-[720px]">
			{guide.dateRule && <DateTable rule={guide.dateRule} />}
		</div>

		{guide.image && (
			<figure class="m-0 mt-10">
				<img
					src={guide.image}
					alt={guide.imageAlt ?? guide.title}
					class="mx-auto h-auto max-h-[62vh] w-auto max-w-full border border-[var(--rule)]"
					loading="eager"
				/>
				{guide.imageCredit && (
					<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(guide.imageCredit)} />
				)}
			</figure>
		)}

		<div class="mx-auto mt-11 max-w-[680px]">
			<div class="panel px-5 py-5">
				<p class="rubric m-0">In brief</p>
				<p class="font-prose mt-3 mb-0 text-[1.1rem] leading-relaxed text-[var(--ink)]">{guide.coreSummary}</p>
			</div>

			{guide.founding && (
				<div class="mt-6 border-l-2 border-[var(--rule)] pl-5">
					<p class="rubric m-0">
						{guide.founding.status === 'documented' ? 'Who started it' : 'Who started it — unresolved'}
					</p>
					<p class="mt-2 mb-0 text-[0.975rem] leading-[1.8] text-[var(--ink)]/80" set:html={md(guide.founding.text)} />
					{guide.founding.source && (
						<p class="mt-2 mb-0 text-xs text-[var(--ink)]/50">
							<a href={guide.founding.source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/60 underline underline-offset-2">{guide.founding.source.label}</a>
						</p>
					)}
				</div>
			)}

			<article class="mt-11">
				{guide.sections.map((section) => (
					<section class="mb-10 last:mb-0">
						<h2 class="font-display mb-4 text-[1.5rem] leading-snug font-semibold text-[var(--ink)]">{section.heading}</h2>
						{section.body.map((paragraph) => (
							<p class="font-prose mb-4 text-[1.05rem] leading-[1.85] text-[var(--ink)]/85 last:mb-0" set:html={md(paragraph)} />
						))}
						{section.image && (
							<figure class="m-0 mt-7">
								<img
									src={section.image.src}
									alt={section.image.alt}
									class="mx-auto h-auto max-h-[60vh] w-auto max-w-full border border-[var(--rule)]"
									loading="lazy"
								/>
								{section.image.credit && (
									<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(section.image.credit)} />
								)}
							</figure>
						)}
					</section>
				))}
			</article>

			{guide.faq && guide.faq.length > 0 && (
				<div class="mt-14 border-t-2 border-[var(--ink)] pt-6">
					<h2 class="font-display m-0 text-2xl font-semibold text-[var(--ink)]">Frequently asked questions</h2>
					<div class="mt-2 flex flex-col">
						{guide.faq.map((item) => (
							<div class="border-b border-[var(--rule)] py-5 last:border-b-0">
								<p class="font-display m-0 text-[1.12rem] font-semibold text-[var(--ink)]">{item.question}</p>
								<p class="mt-2 mb-0 text-[0.95rem] leading-relaxed text-[var(--ink)]/70" set:html={md(item.answer)} />
							</div>
						))}
					</div>
				</div>
			)}

			{guide.sources && guide.sources.length > 0 && (
				<div class="mt-12 border-t border-[var(--rule)] pt-5">
					<p class="rubric m-0">Sources</p>
					<ul class="mt-3 mb-0 list-none pl-0 text-sm text-[var(--ink)]/65">
						{guide.sources.map((s) => (
							<li class="py-1">
								<a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{s.label}</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		{related.length > 0 && (
			<div class="mt-16">
				<h3 class="font-display m-0 text-xl font-semibold text-[var(--ink)]">Also on the calendar</h3>
				<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{related.map((g) => (
						<a href={`/${g.slug}/`} class="entry panel block px-4 py-4 no-underline">
							<p class="rubric m-0">{g.category}</p>
							<p class="font-display entry-title m-0 mt-1.5 text-[1.05rem] leading-snug font-semibold text-[var(--ink)]">{g.title}</p>
							{g.dateRule?.occurrences[0] && (
								<p class="m-0 mt-2 text-xs text-[var(--ink)]/50">{g.dateRule.text}</p>
							)}
						</a>
					))}
				</div>
			</div>
		)}

		<div class="mx-auto mt-14 max-w-[680px] border-t border-[var(--rule)] pt-5 text-sm text-[var(--ink)]/55">
			<p class="m-0">Written and edited by <a href="/about/" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{AUTHOR_NAME}</a></p>
		</div>
	</div>
</Layout>

<style>
	.entry {
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}
	.entry:hover {
		border-color: var(--flag);
		box-shadow: 0 1px 2px rgb(31 29 26 / 0.06);
	}
	.entry:hover .entry-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.entry {
			transition: none;
		}
	}
</style>
