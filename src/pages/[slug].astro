---
import Layout from '../layouts/Layout.astro';
import Article from '../../vendor/site-toolkit/packages/schema/src/Article.astro';
import BreadcrumbList from '../../vendor/site-toolkit/packages/schema/src/BreadcrumbList.astro';
import FAQPage from '../../vendor/site-toolkit/packages/schema/src/FAQPage.astro';
import { pickRelatedGuides } from '../../vendor/site-toolkit/packages/related-guides/src/index.ts';
import CountdownWidget from '../components/CountdownWidget.astro';
import DateTable from '../components/DateTable.astro';
import ObservanceEvents from '../components/ObservanceEvents.astro';
import { guides, categorySlug, type Guide } from '../data/guides';
import { AUTHOR_NAME, SITE_ORIGIN } from '../consts';

export function getStaticPaths() {
	return guides.map((guide) => ({
		params: { slug: guide.slug },
		props: { guide },
	}));
}

interface Props {
	guide: Guide;
}

const { guide } = Astro.props;
// Rotating-window related-guides selection -- see vendor/site-toolkit/packages/related-guides
// for why this isn't a fixed .slice(0, 6) (that bug starved most of a category of any inbound link).
const related = pickRelatedGuides(guides, guide);

// Categories are open strings (the calendar keeps growing new families of pages), so
// the path is derived rather than looked up.
const catPath = `/topics/${categorySlug(guide.category)}/`;

const pageUrl = `${SITE_ORIGIN}/${guide.slug}/`;
const heroImage = `${SITE_ORIGIN}${guide.image ?? '/favicon.svg'}`;
const toISO = (d: string) => `${d}T00:00:00+00:00`;
const breadcrumbItems = [
	{ name: 'Home', item: `${SITE_ORIGIN}/` },
	{ name: guide.category, item: `${SITE_ORIGIN}${catPath}` },
	{ name: guide.title, item: pageUrl },
];

function md(text: string): string {
	return text
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		.replace(/\*(.*?)\*/g, '<em>$1</em>')
		.replace(/\[([^\]]+)\]\(((?:[^()]|\([^()]*\))*)\)/g, '<a href="$2">$1</a>');
}

// Same eligibility rule as src/pages/embed/[slug].astro: 'table' dates (Easter, other
// lunisolar/religious calendars) are transcribed rather than generated years ahead, so a
// countdown left running for years on someone else's page could go quietly wrong.
const countdownEligible = guide.dateRule && guide.dateRule.kind !== 'table';

// Mini date blocks for the "nearby on the calendar" rows — same build-time "today"
// contract as DateTable's next-occurrence highlight.
const today = new Date().toISOString().slice(0, 10);
const MONTHS_ABBR = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
function blockParts(date: string) {
	const [, m, d] = date.split('-').map(Number);
	return { mon: MONTHS_ABBR[m - 1], day: String(d).padStart(2, '0') };
}
function relatedNext(g: Guide) {
	return g.dateRule?.occurrences.find((o) => o.date >= today) ?? g.dateRule?.occurrences[0];
}
const embedUrl = `${SITE_ORIGIN}/embed/${guide.slug}/`;
const embedSnippet = countdownEligible
	? `<iframe src="${embedUrl}" width="280" height="230" style="border:1px solid #ddd;border-radius:8px" title="Days until ${guide.title}" loading="lazy"></iframe>`
	: '';
import { imgDims } from '../data/imageDims';
---

<Layout title={guide.title} description={guide.description} ogImage={guide.image ?? '/favicon.svg'} ogType="article">
	{guide.faq && guide.faq.length > 0 && <FAQPage items={guide.faq} slot="head" />}
	<Article
		slot="head"
		headline={guide.title}
		description={guide.description}
		datePublished={toISO(guide.published ?? guide.updated)}
		dateModified={toISO(guide.updated)}
		authorName={AUTHOR_NAME}
		authorUrl={`${SITE_ORIGIN}/about/`}
		image={heroImage}
		imageWidth={imgDims(heroImage)?.w}
		imageHeight={imgDims(heroImage)?.h}
		url={pageUrl}
	/>
	<BreadcrumbList slot="head" items={breadcrumbItems} />
	{guide.dateRule && (
		<ObservanceEvents
			slot="head"
			name={guide.title}
			description={guide.description}
			url={pageUrl}
			occurrences={guide.dateRule.occurrences}
		/>
	)}

	<div class="mx-auto max-w-[880px]">
		<nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[var(--ink)]/40">
			<a href="/" class="no-underline hover:text-[var(--ink)] hover:underline">Home</a>
			<span>/</span>
			<a href={catPath} class="no-underline hover:text-[var(--ink)] hover:underline">{guide.category}</a>
		</nav>

		<header class="mx-auto max-w-[720px]">
			<p class="rubric m-0">{guide.category}</p>
			<h1 class="font-display mt-3 text-[2.1rem] leading-[1.12] font-semibold text-[var(--ink)] md:text-[2.6rem]">
				{guide.title}
			</h1>
			<p class="mt-4 text-[1.05rem] leading-relaxed text-[var(--ink)]/65">{guide.description}</p>
			<p class="mt-3 text-xs text-[var(--ink)]/45">Last updated {guide.updated}</p>
		</header>

		<!-- Red-letter annotation: the core answer inked in the margin, kept above the fold. -->
		<div class="mx-auto mt-7 max-w-[720px]">
			<div class="redletter px-5 py-4">
				<p class="rubric m-0">In brief</p>
				<p class="font-prose mt-2 mb-0 text-[1.1rem] leading-relaxed text-[var(--ink)]">{guide.coreSummary}</p>
			</div>
		</div>

		<div class="mx-auto mt-7 max-w-[720px]">
			{guide.dateRule && <DateTable rule={guide.dateRule} />}
		</div>

		{countdownEligible && (
			<div class="mx-auto mt-6 max-w-[320px]">
				<CountdownWidget title={guide.title} occurrences={guide.dateRule!.occurrences} pageUrl={pageUrl} />
			</div>
		)}

		{guide.image && (
			<figure class="m-0 mt-10">
				<img
					src={guide.image}
					alt={guide.imageAlt ?? guide.title}
					class="mx-auto h-auto max-h-[62vh] w-auto max-w-full border border-[var(--rule)]"
					loading="eager"
						width={imgDims(guide.image)?.w}
						height={imgDims(guide.image)?.h}
					/>
				{guide.imageCredit && (
					<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(guide.imageCredit)} />
				)}
			</figure>
		)}

		<div class="mx-auto mt-11 max-w-[680px]">
			{guide.founding && (
				<div class="border-l-2 border-[var(--rule)] pl-5">
					<p class="rubric m-0">
						{guide.founding.status === 'documented' ? 'Who started it' : 'Who started it (unresolved)'}
					</p>
					<p class="mt-2 mb-0 text-[0.975rem] leading-[1.8] text-[var(--ink)]/80" set:html={md(guide.founding.text)} />
					{guide.founding.source && (
						<p class="mt-2 mb-0 text-xs text-[var(--ink)]/50">
							<a href={guide.founding.source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/60 underline underline-offset-2">{guide.founding.source.label}</a>
						</p>
					)}
				</div>
			)}

			<article class="mt-11">
				{guide.sections.map((section) => (
					<section class="mb-10 last:mb-0">
						<h2 class="font-display mb-4 text-[1.5rem] leading-snug font-semibold text-[var(--ink)]">{section.heading}</h2>
						{section.body.map((paragraph) => (
							<p class="font-prose mb-4 text-[1.05rem] leading-[1.85] text-[var(--ink)]/85 last:mb-0" set:html={md(paragraph)} />
						))}
						{section.image && (
							<figure class="m-0 mt-7">
								<img
									src={section.image.src}
									alt={section.image.alt}
									class="mx-auto h-auto max-h-[60vh] w-auto max-w-full border border-[var(--rule)]"
									loading="lazy"
						width={imgDims(section.image.src)?.w}
						height={imgDims(section.image.src)?.h}
					/>
								{section.image.credit && (
									<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(section.image.credit)} />
								)}
							</figure>
						)}
					</section>
				))}
			</article>

			{guide.faq && guide.faq.length > 0 && (
				<div class="mt-14 border-t-2 border-[var(--ink)] pt-6">
					<h2 class="font-display m-0 text-2xl font-semibold text-[var(--ink)]">Frequently asked questions</h2>
					<div class="mt-7 flex flex-col gap-8">
						{guide.faq.map((item) => (
							<div>
								<p class="m-0 flex items-baseline gap-3">
									<span class="faq-q text-[1.55rem] leading-none" aria-hidden="true">Q.</span>
									<span class="font-display text-[1.12rem] leading-snug font-semibold text-[var(--ink)]">{item.question}</span>
								</p>
								<p class="mt-2 mb-0 pl-[2.5rem] text-[0.95rem] leading-relaxed text-[var(--ink)]/75" set:html={md(item.answer)} />
							</div>
						))}
					</div>
				</div>
			)}

			{guide.sources && guide.sources.length > 0 && (
				<div class="mt-12 border-t border-[var(--rule)] pt-5">
					<p class="rubric m-0">Sources</p>
					<ul class="mt-3 mb-0 list-none pl-0 text-sm text-[var(--ink)]/65">
						{guide.sources.map((s) => (
							<li class="py-1">
								<a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{s.label}</a>
							</li>
						))}
					</ul>
				</div>
			)}

			{countdownEligible && (
				<div class="panel mt-12 px-5 py-5 sm:px-6">
					<p class="rubric m-0">Embed this countdown</p>
					<p class="mt-2 mb-3 text-sm leading-relaxed text-[var(--ink)]/65">
						Paste this into any blog post or web page to show a live "days until {guide.title}" counter, free to
						use, with the attribution link staying in place.
					</p>
					<textarea
						id="embed-code"
						readonly
						rows="2"
						class="w-full rounded-lg border border-[var(--rule)] bg-[var(--paper)] p-3 font-mono text-xs leading-relaxed text-[var(--ink)]/80"
						set:text={embedSnippet}
					/>
					<button
						id="copy-embed"
						type="button"
						class="mt-2 rounded-[6px] border border-[var(--rule)] px-4 py-2 text-xs font-semibold uppercase tracking-wide text-[var(--ink)]/70 hover:border-[var(--flag)] hover:text-[var(--flag-dark)]"
					>
						Copy embed code
					</button>
				</div>
			)}
		</div>

		{related.length > 0 && (
			<div class="mt-16">
				<h3 class="font-display m-0 border-b-2 border-[var(--ink)] pb-2 text-xl font-semibold text-[var(--ink)]">Nearby on the calendar</h3>
				<ul class="m-0 mt-1 list-none p-0">
					{related.map((g) => {
						const occ = relatedNext(g);
						const p = occ ? blockParts(occ.date) : null;
						return (
							<li class="border-b border-[var(--rule)] last:border-b-0">
								<a href={`/${g.slug}/`} class="entry flex items-start gap-4 py-3.5 no-underline">
									{p ? (
										<span class="date-block mt-0.5" aria-hidden="true">
											<span class="db-month">{p.mon}</span>
											<span class="db-day">{p.day}</span>
										</span>
									) : (
										<span class="date-block mt-0.5" aria-hidden="true">
											<span class="db-month">REF</span>
											<span class="db-day">&sect;</span>
										</span>
									)}
									<span class="min-w-0 flex-1">
										<span class="rubric block">{g.category}</span>
										<span class="font-display entry-title mt-0.5 block text-[1.05rem] leading-snug font-semibold text-[var(--ink)]">{g.title}</span>
										{g.dateRule && (
											<span class="mt-0.5 block text-[0.85rem] leading-relaxed text-[var(--ink)]/70">{g.dateRule.text}</span>
										)}
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		)}

		<div class="da-feedback redletter mx-auto mt-14 max-w-[680px] px-5 py-4" data-da-fb>
			<p class="rubric m-0">Reader's note</p>
			<p class="font-display m-0 mt-2 text-[1.12rem] leading-snug font-semibold text-[var(--ink)]">Was this day's page useful?</p>
			<div class="mt-3.5 flex flex-wrap gap-3">
				<button type="button" class="da-fb-btn" data-da-fb-btn="helpful">Yes, useful</button>
				<button type="button" class="da-fb-btn" data-da-fb-btn="not_helpful">Not really</button>
			</div>
			<div class="da-fb-msgs mt-3" aria-live="polite">
				<p class="m-0 text-sm text-[var(--ink)]/70" data-da-fb-thanks hidden>Noted in the margin. Thank you.</p>
				<p class="m-0 mt-0.5 text-sm text-[var(--ink)]/70" data-da-fb-missing hidden>
					Tell us what's missing: <a class="da-fb-mail" data-da-fb-mail href="mailto:contact@dayalmanac.com?subject=Page%20feedback">write to the almanac</a>
				</p>
			</div>
		</div>

		<div class="mx-auto mt-14 max-w-[680px] border-t border-[var(--rule)] pt-5 text-sm text-[var(--ink)]/55">
			<p class="m-0">Written and edited by the <a href="/about/" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{AUTHOR_NAME}</a></p>
		</div>
	</div>
</Layout>

<script is:inline>
	(function () {
		var root = document.querySelector('[data-da-fb]');
		if (!root) return;
		var btns = root.querySelectorAll('[data-da-fb-btn]');
		var thanks = root.querySelector('[data-da-fb-thanks]');
		var missing = root.querySelector('[data-da-fb-missing]');
		var mail = root.querySelector('[data-da-fb-mail]');
		btns.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var verdict = btn.getAttribute('data-da-fb-btn');
				try {
					if (typeof window.gtag === 'function') {
						window.gtag('event', 'page_feedback', { verdict: verdict });
					}
				} catch (e) {}
				btns.forEach(function (b) {
					b.disabled = true;
				});
				btn.setAttribute('aria-pressed', 'true');
				if (thanks) thanks.hidden = false;
				if (verdict === 'not_helpful' && missing) {
					if (mail) {
						mail.href =
							'mailto:contact@dayalmanac.com?subject=' +
							encodeURIComponent('Page feedback: ' + location.pathname);
					}
					missing.hidden = false;
				}
			});
		});
	})();
</script>

<style>
	/* Reader's-note margin box: same red-edged annotation treatment as the
	   "In brief" redletter, with calendar-red ink reserved for the verdict. */
	/* Reserve room for the tallest post-click state (thanks + mailto line
	   wrapping to two lines at 375px) so nothing below shifts. */
	.da-fb-msgs {
		min-height: 3rem;
	}
	.da-fb-btn {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink); /* #1f1d1a on #fffdf8 — 16.4:1 */
		background: var(--paper);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 0.5rem 1rem;
		cursor: pointer;
	}
	.da-fb-btn:hover:not(:disabled) {
		border-color: var(--flag);
		color: var(--flag-dark);
	}
	.da-fb-btn:focus-visible {
		outline: 2px solid var(--flag-dark);
		outline-offset: 2px;
	}
	.da-fb-btn[aria-pressed='true'] {
		background: var(--flag-dark); /* #862a22; paper text on it — 8.0:1 */
		border-color: var(--flag-dark);
		color: var(--paper);
	}
	.da-fb-btn:disabled {
		cursor: default;
	}
	.da-fb-btn:disabled:not([aria-pressed='true']) {
		opacity: 0.45;
	}
	.da-fb-mail {
		color: var(--flag-dark); /* #862a22 on #fffdf8 — 8.0:1 */
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.da-fb-mail:hover {
		color: var(--ink);
	}

	.entry:hover .entry-title {
		color: var(--flag-dark);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>

<script>
	const btn = document.getElementById('copy-embed');
	const code = document.getElementById('embed-code') as HTMLTextAreaElement | null;
	btn?.addEventListener('click', async () => {
		if (!code) return;
		try {
			await navigator.clipboard.writeText(code.value);
		} catch {
			code.select();
			document.execCommand('copy');
		}
		btn.textContent = 'Copied!';
		setTimeout(() => (btn.textContent = 'Copy embed code'), 1500);
	});
</script>
