---
import Layout from '../layouts/Layout.astro';
import WebSite from '../../vendor/site-toolkit/packages/schema/src/WebSite.astro';
import { guides, categorySlug, formatOccurrence, type Guide, type Occurrence } from '../data/guides';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_ORIGIN } from '../consts';

const today = new Date().toISOString().slice(0, 10);

/** The next occurrence of a dated guide, or null for undated explainers. */
function nextDate(g: Guide): string | null {
	return g.dateRule?.occurrences.find((o) => o.date >= today)?.date ?? null;
}

// The front page of an almanac is a calendar, not a blog roll: what is coming up, soonest
// first. Undated pages fall to a separate list below rather than being sorted in with a
// fake date.
const dated = guides
	.filter((g) => nextDate(g) !== null)
	.sort((a, b) => nextDate(a)!.localeCompare(nextDate(b)!));
const undated = guides.filter((g) => nextDate(g) === null);

const categories = [...new Set(guides.map((g) => g.category))].sort();

// -- Today's leaf ------------------------------------------------------------
// Everything on the leaf is real, build-time data: the build date itself, plus the
// entries whose next occurrence IS that date. When the sheet is blank, the leaf says
// so and points at the nearest date that actually carries something — no invented
// "today's holiday".
const MONTHS_FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const MONTHS_ABBR = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const [ty, tm, td] = today.split('-').map(Number);
const todayWeekday = WEEKDAYS[new Date(`${today}T12:00:00Z`).getUTCDay()];

const todaysEntries = dated.filter((g) => nextDate(g) === today);
// dated is sorted ascending, so when nothing falls today the head of the list carries
// the nearest date with entries on it.
const upcomingDate = todaysEntries.length === 0 && dated.length > 0 ? nextDate(dated[0])! : null;
const upcomingEntries = upcomingDate ? dated.filter((g) => nextDate(g) === upcomingDate) : [];
const upcomingOcc: Occurrence | undefined = upcomingEntries[0]?.dateRule!.occurrences.find(
	(o) => o.date >= today,
);

/** Month strip + day number for the mini date blocks in the row lists. */
function blockParts(date: string) {
	const [, m, d] = date.split('-').map(Number);
	return { mon: MONTHS_ABBR[m - 1], day: String(d).padStart(2, '0') };
}
---

<Layout>
	<WebSite slot="head" name={SITE_TITLE} description={SITE_DESCRIPTION} url={`${SITE_ORIGIN}/`} />

	<!-- Today's leaf: a tear-off calendar page, perforated along the bottom edge. -->
	<section class="mx-auto max-w-[620px]">
		<div class="leaf-torn">
			<div class="flex items-center justify-between bg-[var(--flag)] px-5 py-2 text-[0.68rem] font-bold tracking-[0.16em] text-[var(--leaf)] uppercase">
				<span>{todayWeekday}</span>
				<span>{MONTHS_FULL[tm - 1]} {ty}</span>
			</div>
			<div class="px-5 pt-3 pb-8 text-center sm:px-7">
				<p class="font-display m-0 text-[5.5rem] leading-none font-bold text-[var(--flag)] tabular-nums md:text-[6.75rem]">
					{td}
				</p>
				{todaysEntries.length > 0 ? (
					<div class="mt-3">
						<p class="rubric m-0">On today's sheet</p>
						<ul class="m-0 mt-2 list-none p-0">
							{todaysEntries.map((g) => (
								<li class="py-1">
									<a href={`/${g.slug}/`} class="font-display text-[1.05rem] leading-snug font-semibold text-[var(--flag-dark)] no-underline hover:underline">
										{g.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				) : upcomingOcc ? (
					<div class="mt-3">
						<p class="m-0 text-[0.9rem] leading-relaxed text-[var(--ink)]/70">
							Nothing is marked on today's sheet. The next red-letter date is
							<span class="font-display font-semibold text-[var(--flag-dark)]"> {formatOccurrence(upcomingOcc)}</span>:
						</p>
						<ul class="m-0 mt-2 list-none p-0">
							{upcomingEntries.map((g) => (
								<li class="py-1">
									<a href={`/${g.slug}/`} class="font-display text-[1.05rem] leading-snug font-semibold text-[var(--flag-dark)] no-underline hover:underline">
										{g.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				) : null}
			</div>
		</div>

		<h1 class="font-display mx-auto mt-9 mb-0 text-center text-[1.15rem] leading-snug font-semibold text-[var(--ink)]">
			The calendar, with its sources shown
		</h1>
		<p class="mx-auto mt-2 mb-0 max-w-[540px] text-center text-[0.925rem] leading-relaxed text-[var(--ink)]/70">
			When each observance falls, what it is, and who started it. Traced to a named founder or
			proclamation where one exists, and said plainly where nobody can find one.
		</p>
	</section>

	{dated.length > 0 && (
		<section class="mt-12">
			<div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-2">
				<h2 class="font-display m-0 text-xl font-semibold text-[var(--ink)]">Coming up</h2>
				<a href="/topics/" class="text-[0.8rem] text-[var(--ink)]/70 no-underline hover:text-[var(--flag-dark)] hover:underline">All topics</a>
			</div>

			<ul class="m-0 mt-1 list-none p-0">
				{dated.map((g) => {
					const next = g.dateRule!.occurrences.find((o) => o.date >= today)!;
					const p = blockParts(next.date);
					return (
						<li class="border-b border-[var(--rule)]">
							<a href={`/${g.slug}/`} class="entry flex items-start gap-4 py-4 no-underline">
								<span class="date-block mt-0.5" aria-hidden="true">
									<span class="db-month">{p.mon}</span>
									<span class="db-day">{p.day}</span>
								</span>
								<span class="min-w-0 flex-1">
									<span class="font-display block text-[0.8rem] font-semibold text-[var(--flag-dark)] tabular-nums">
										{formatOccurrence(next)}
									</span>
									<span class="font-display entry-title mt-0.5 block text-[1.1rem] leading-snug font-semibold text-[var(--ink)]">{g.title}</span>
									<span class="mt-0.5 block text-[0.9rem] leading-relaxed text-[var(--ink)]/70">{g.description}</span>
								</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)}

	{undated.length > 0 && (
		<section class="mt-14">
			<h2 class="font-display m-0 border-b-2 border-[var(--ink)] pb-2 text-xl font-semibold text-[var(--ink)]">
				Reference
			</h2>
			<ul class="m-0 mt-1 list-none p-0">
				{undated.map((g) => (
					<li class="border-b border-[var(--rule)]">
						<a href={`/${g.slug}/`} class="entry block py-4 no-underline">
							<span class="rubric">{g.category}</span>
							<span class="font-display entry-title mt-1 block text-[1.1rem] leading-snug font-semibold text-[var(--ink)]">{g.title}</span>
							<span class="mt-0.5 block text-[0.9rem] leading-relaxed text-[var(--ink)]/70">{g.description}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	{guides.length === 0 && (
		<section class="mx-auto mt-16 max-w-[560px]">
			<div class="panel px-6 py-7 text-center">
				<p class="rubric m-0">In preparation</p>
				<p class="mt-3 mb-0 text-[0.975rem] leading-relaxed text-[var(--ink)]/70">
					The first entries are being checked against their founding documents. Nothing goes up
					here until its date and its origin can both be sourced.
				</p>
			</div>
		</section>
	)}

	{categories.length > 0 && (
		<section class="mt-14 border-t border-[var(--rule)] pt-5">
			<div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
				<h2 class="rubric m-0 text-[0.65rem]">Topics</h2>
				{categories.map((c) => (
					<a href={`/topics/${categorySlug(c)}/`} class="text-[0.9rem] font-semibold text-[var(--flag-dark)] no-underline hover:underline">{c}</a>
				))}
			</div>
		</section>
	)}
</Layout>

<style>
	.entry:hover .entry-title {
		color: var(--flag-dark);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
