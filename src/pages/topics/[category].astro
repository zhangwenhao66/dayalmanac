---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbList from '../../../vendor/site-toolkit/packages/schema/src/BreadcrumbList.astro';
import { guides, categorySlug, formatOccurrence, type Guide } from '../../data/guides';
import { SITE_ORIGIN } from '../../consts';

export function getStaticPaths() {
	const names = [...new Set(guides.map((g) => g.category))];
	return names.map((name) => ({
		params: { category: categorySlug(name) },
		props: { name, entries: guides.filter((g) => g.category === name) },
	}));
}

interface Props {
	name: string;
	entries: Guide[];
}

const { name, entries } = Astro.props;
const today = new Date().toISOString().slice(0, 10);

function nextDate(g: Guide): string | null {
	return g.dateRule?.occurrences.find((o) => o.date >= today)?.date ?? null;
}

// Dated entries first, soonest occurrence first; undated entries after, alphabetically.
const sorted = [...entries].sort((a, b) => {
	const da = nextDate(a);
	const db = nextDate(b);
	if (da && db) return da.localeCompare(db);
	if (da) return -1;
	if (db) return 1;
	return a.title.localeCompare(b.title);
});

const catPath = `/topics/${categorySlug(name)}/`;
const breadcrumbItems = [
	{ name: 'Home', item: `${SITE_ORIGIN}/` },
	{ name: 'Topics', item: `${SITE_ORIGIN}/topics/` },
	{ name, item: `${SITE_ORIGIN}${catPath}` },
];
---

<Layout title={name} description={`Every ${name.toLowerCase()} entry on DayAlmanac, with the date rule and founding source for each.`}>
	<BreadcrumbList slot="head" items={breadcrumbItems} />

	<div class="mx-auto max-w-[760px]">
		<nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[var(--ink)]/40">
			<a href="/" class="no-underline hover:text-[var(--ink)] hover:underline">Home</a>
			<span>/</span>
			<a href="/topics/" class="no-underline hover:text-[var(--ink)] hover:underline">Topics</a>
		</nav>

		<h1 class="font-display m-0 text-[2.1rem] leading-tight font-semibold text-[var(--ink)]">{name}</h1>
		<p class="mt-3 text-sm text-[var(--ink)]/50">
			{sorted.length} {sorted.length === 1 ? 'entry' : 'entries'}
		</p>

		<ul class="m-0 mt-9 list-none p-0">
			{sorted.map((g) => {
				const next = g.dateRule?.occurrences.find((o) => o.date >= today);
				return (
					<li class="border-b border-[var(--rule)] first:border-t">
						<a href={`/${g.slug}/`} class="entry block py-4 no-underline">
							{next && (
								<span class="font-display block text-[0.85rem] font-semibold text-[var(--flag-dark)] tabular-nums">
									{formatOccurrence(next)}
								</span>
							)}
							<span class="font-display entry-title mt-0.5 block text-[1.1rem] leading-snug font-semibold text-[var(--ink)]">{g.title}</span>
							<span class="mt-0.5 block text-[0.9rem] leading-relaxed text-[var(--ink)]/60">{g.description}</span>
						</a>
					</li>
				);
			})}
		</ul>
	</div>
</Layout>

<style>
	.entry:hover .entry-title {
		color: var(--flag-dark);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
